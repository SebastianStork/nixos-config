+"""Replace an entry's content with a link to the original article."""
+
+import html
+
+import rss2email.email
+
+
+def process(feed, parsed, entry, guid, message):
+    title = html.escape(feed._get_entry_title(entry))
+    url = html.escape(feed._get_entry_link(entry) or '', quote=True)
+    content = (
+        '<!DOCTYPE html>\n'
+        '<html><body>\n'
+        f'<p><a href="{url}">{title}</a></p>\n'
+        '</body></html>\n'
+        )
+    encoding = rss2email.email.guess_encoding(
+        content, encodings=feed.encodings)
+    del message['Content-Transfer-Encoding']
+    message.set_payload(content, charset=encoding)
+    return message
